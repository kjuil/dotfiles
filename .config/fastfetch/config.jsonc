{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "padding": {
            "left": 5,
            "right": 5,
            "top": 2
        }
    },
    "display": {
        "separator": ""
        // "size": {
        //     "binaryPrefix": "si"
        // }
    },
    "modules": [
        {
            "type": "title",
            "format": "╭────────────────{#1}[{user-name-colored}{at-symbol-colored}{host-name-colored}]"
        },
        {
            "type": "custom",
            "format": "├ {#1}System Information"
        },
        {
            "key": "│   OS          ",
            "keyColor": "red",
            "type": "os"
        },
        {
            "key": "│  󰌢 Machine     ",
            "keyColor": "red",
            "type": "host"
        },
        {
            "key": "│   Kernel      ",
            "keyColor": "red",
            "type": "kernel"
        },
        {
            "key": "│   Uptime      ",
            "keyColor": "red",
            "type": "uptime"
        },
        {
            "key": "│  󰩟 Local IP    ",
            "keyColor": "red",
            "type": "localip",
            "compact": true
        },
        {
            "type": "custom",
            "format": "│"
        },
        {
            "type": "custom",
            "format": "├ {#1}Desktop Environment"
        },
        {
            "key": "│  󰧨 LM          ",
            "keyColor": "blue",
            "type": "lm"
        },
        {
            "key": "│   WM          ",
            "keyColor": "blue",
            "type": "wm"
        },
        {
            "key": "│   DE          ",
            "keyColor": "blue",
            "type": "de"
        },
        {
            "key": "│  󰍹 Resolution  ",
            "keyColor": "blue",
            "type": "display",
            "compactType": "original-with-refresh-rate"
        },
        {
            "key": "│   Terminal    ",
            "keyColor": "blue",
            "type": "terminal"
        },
        {
            "key": "│   Shell       ",
            "keyColor": "blue",
            "type": "shell"
        },
        {
            "type": "custom",
            "format": "│"
        },
        {
            "type": "custom",
            "format": "├ {#1}Hardware Information"
        },
        {
            "key": "│   CPU         ",
            "keyColor": "green",
            "type": "cpu"
        },
        {
            "key": "│  󰾲 GPU         ",
            "keyColor": "green",
            "type": "gpu"
        },
        {
            "key": "│   Memory      ",
            "keyColor": "green",
            "type": "memory"
        },
        {
            "key": "│   Disk        ",
            "keyColor": "green",
            "type": "disk"
        },
        {
            "type": "custom",
            "format": "│"
        },
        {
            "key": "│   colors      ",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "type": "title",
            "format": "╰───────────────────────────────────────────────────────────────╯"
        }
    ]
}
